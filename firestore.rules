rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Authorized administrators
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          "9VuRSJuuEKc7fOQAjywrSIVB8Ql2",
          "DcTMZFM3YhO5os0GSnVs1FIFW272"
        ];
    }

    // Only published content is publicly visible
    function isPublished() {
      return resource.data.published == true;
    }

    // Artistic projects
    match /projects/{projectId} {
      allow read: if isAdmin() || isPublished();
      allow create, update, delete: if isAdmin();
    }

    // Classes, workshops and professional interventions
    match /workshops/{workshopId} {
      allow read: if isAdmin() || isPublished();
      allow create, update, delete: if isAdmin();
    }

    // Public site content: titles, descriptions and introductions
    match /siteContent/introductions {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Deny access to all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
